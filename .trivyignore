# .trivyignore
# gosu binary in postgres:16-alpine is statically compiled with an old Go
# toolchain by upstream maintainers (docker-library/postgres) — not
# patchable via apk. gosu is only used internally by the entrypoint to
# drop root privileges at container init; not exposed to external input.
# Re-check for an upstream postgres:16-alpine rebuild periodically.
usr/local/bin/gosu
